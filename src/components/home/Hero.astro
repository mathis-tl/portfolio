---
import { getImage, Image } from "astro:assets";
import photo from "../../assets/photo.png";
import { getConfigurationCollection } from "../../lib/utils";
import Anchor from "../common/Anchor.astro";

const { data: config } = await getConfigurationCollection();
const pixelPhoto = await getImage({
  src: photo,
  width: 32,
  height: 32,
  position: "top",
  format: "png",
});
---

<div class="px-dots flex flex-col items-center sm:flex-row gap-8 p-6 sm:p-8">
  <div
    class="photo-frame relative h-40 w-40 shrink-0 border-4 border-zag-dark shadow-[8px_8px_0_var(--px-green)] dark:border-zag-light"
  >
    <Image
      src={photo}
      alt="Portrait de Mathis Telle, souriant, en col roulé bleu marine"
      width={320}
      height={320}
      position="top"
      loading="eager"
      class="h-full w-full object-cover"
    />
    <img
      src={pixelPhoto.src}
      alt=""
      width="160"
      height="160"
      class="pixel-layer absolute inset-0 h-full w-full"
      aria-hidden="true"
    />
  </div>
  <div>
    <h1
      class="text-3xl sm:text-4xl font-display font-semibold text-center sm:text-left text-px-yellow"
    >
      {config.hero.title}
    </h1>
    <p
      class="mt-2 text-center text-xl sm:text-2xl font-mono font-medium sm:text-left"
      set:html={config.hero.subtitle}
    />
    <div class="mt-4 flex justify-center sm:justify-start font-mono">
      <Anchor url={config.hero.ctaUrl}>{config.hero.ctaText}</Anchor>
    </div>
  </div>
</div>

<style>
  .pixel-layer {
    display: none;
    image-rendering: pixelated;
  }

  @media (hover: hover) and (pointer: fine) {
    .pixel-layer {
      display: block;
      transition: opacity 0.2s ease-in-out;
    }

    .photo-frame:hover .pixel-layer {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel-layer {
      transition: none;
    }
  }
</style>
