---
import { getConfigurationCollection } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import Section from "./common/Section.astro";

const { data: config } = await getConfigurationCollection();

const menuLabels = {
  home: "Accueil",
  projects: "Projets",
} as const;

const date = new Date();
const year = date.getFullYear();
---

<footer class="mt-16 mb-8">
  <Section class="mb-4">
    <div
      class="zag-border-b zag-transition pb-4 flex flex-col sm:flex-row sm:flex-nowrap gap-8 sm:items-center"
    >
      <ul class="flex flex-col gap-2">
        {
          (Object.keys(menuLabels) as Array<keyof typeof menuLabels>).map(
            (key) => (
              <li>
                <Anchor url={config.menu[key]}>{menuLabels[key]}</Anchor>
              </li>
            ),
          )
        }
      </ul>
      <div class="flex flex-start items-start gap-4 w-full">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          class="zag-fill zag-transition w-8 h-8 min-h-8 min-w-8 max-h-8 max-w-8 -translate-y-2"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="m10 7l-2 4h3v6H5v-6l2-4zm8 0l-2 4h3v6h-6v-6l2-4z"></path>
        </svg>
        <p class="zag-text zag-transition">
          Des systèmes testés, qui signalent leurs cas douteux plutôt que de
          les masquer.
        </p>
      </div>
      <div class="flex flex-row sm:flex-col gap-4 items-start">
        {
          config.personal.email && (
            <Anchor
              url={`mailto:${config.personal.email}`}
              aria-label="Envoyer un e-mail à Mathis Telle"
            >
              E-mail
            </Anchor>
          )
        }
        {
          config.personal.linkedinProfile && (
            <Anchor
              url={config.personal.linkedinProfile}
              external
              aria-label="Profil LinkedIn de Mathis Telle"
            >
              LinkedIn
            </Anchor>
          )
        }
        {
          config.personal.cvUrl && (
            <Anchor
              url={config.personal.cvUrl}
              external
              aria-label="CV de Mathis Telle au format PDF"
            >
              CV (PDF)
            </Anchor>
          )
        }
        {
          config.personal.githubProfile && (
            <Anchor
              url={config.personal.githubProfile}
              aria-label="Profil GitHub de Mathis Telle"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
              >
                <title>GitHub</title>
                <path
                  class="zag-fill zag-transition"
                  d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
                />
              </svg>
            </Anchor>
          )
        }
      </div>
    </div>
  </Section>
  <p class="zag-text zag-transition text-center text-sm font-medium">
    &copy; {year}&nbsp;{config.personal.name}. Tous droits réservés.
  </p>
</footer>
