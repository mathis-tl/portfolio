---
import { getConfigurationCollection } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import ThemeToggle from "./ThemeToggle.astro";

const { data: config } = await getConfigurationCollection();

const menuLabels = {
  home: "Accueil",
  projects: "Projets",
} as const;
---

<header class="zag-bg zag-border-b zag-transition sticky top-0 w-full z-10">
  <div
    class="zag-bg zag-transition sm:hidden relative z-50 py-4 flex items-center justify-between pr-4"
  >
    <button
      id="menu-bouton"
      class="px-4 focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-zag-dark dark:focus:outline-zag-light"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="navigation"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 512 512"
        class="zag-fill zag-transition"
        aria-hidden="true"
      >
        <path d="M80 96h352v32H80zm0 144h352v32H80zm0 144h352v32H80z"></path>
      </svg>
    </button>
    <a
      href="/"
      class="px-name font-display text-xs px-2 py-1 focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-zag-dark dark:focus:outline-zag-light"
    >
      {config.personal.name}
    </a>
  </div>
  <nav
    id="navigation"
    class="zag-bg zag-border-b zag-transition fixed sm:relative inset-x-0 top-0 h-auto sm:px-4 flex justify-between flex-col gap-8 py-4 text-xl sm:flex-row max-w-2xl mx-auto sm:pt-4 sm:border-none"
  >
    <div
      class="flex flex-col font-mono font-medium gap-x-4 gap-y-2 sm:flex-row sm:flex-wrap sm:items-center px-4 sm:px-0 mt-16 sm:mt-0 [&_a]:whitespace-nowrap"
    >
      <a
        href="/"
        class="px-name hidden sm:inline-block font-display text-sm px-2 py-1 focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-zag-dark dark:focus:outline-zag-light"
      >
        {config.personal.name}
      </a>
      {
        (Object.keys(menuLabels) as Array<keyof typeof menuLabels>).map(
          (key) => <Anchor url={config.menu[key]}>{menuLabels[key]}</Anchor>,
        )
      }
      {
        config.personal.email && (
          <Anchor
            url={`mailto:${config.personal.email}`}
            aria-label="Envoyer un e-mail à Mathis Telle"
          >
            E-mail
          </Anchor>
        )
      }
      {
        config.personal.linkedinProfile && (
          <Anchor
            url={config.personal.linkedinProfile}
            external
            aria-label="Profil LinkedIn de Mathis Telle"
          >
            LinkedIn
          </Anchor>
        )
      }
      {
        config.personal.cvUrl && (
          <Anchor
            url={config.personal.cvUrl}
            external
            aria-label="CV (PDF) de Mathis Telle"
          >
            CV (PDF)
          </Anchor>
        )
      }
    </div>
    <div class="flex gap-4 justify-between px-4 sm:px-0">
      {
        config.personal.githubProfile && (
          <Anchor
            url={config.personal.githubProfile}
            aria-label="Profil GitHub de Mathis Telle"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              class="zag-fill zag-transition"
            >
              <title>GitHub</title>
              <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2" />
            </svg>
          </Anchor>
        )
      }
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById("menu-bouton");
  const nav = document.getElementById("navigation");
  const pageParts = document.querySelectorAll("main, footer");
  const mobileQuery = window.matchMedia("(width < 40rem)");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let isOpen = false;

  function updateNavState() {
    if (!(button instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) {
      return;
    }

    nav.style.transition = reduceMotion.matches ? "none" : "";

    const isMobile = mobileQuery.matches;
    if (isMobile) {
      nav.style.transform = isOpen ? "translateY(0)" : "translateY(-100%)";
      nav.toggleAttribute("inert", !isOpen);
      for (const part of pageParts) part.toggleAttribute("inert", isOpen);
    } else {
      nav.style.transform = "translateY(0)";
      nav.removeAttribute("inert");
      for (const part of pageParts) part.removeAttribute("inert");
      isOpen = false;
    }

    button.setAttribute("aria-expanded", String(isOpen));
    button.setAttribute(
      "aria-label",
      isOpen ? "Fermer le menu" : "Ouvrir le menu",
    );
  }

  function toggleNav() {
    isOpen = !isOpen;
    updateNavState();
  }

  function closeNav() {
    if (!isOpen || !(button instanceof HTMLButtonElement)) {
      return;
    }
    isOpen = false;
    updateNavState();
    button.focus();
  }

  button?.addEventListener("click", toggleNav);
  window.addEventListener("resize", updateNavState);
  mobileQuery.addEventListener("change", updateNavState);
  reduceMotion.addEventListener("change", updateNavState);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeNav();
    }
  });

  updateNavState();
</script>
