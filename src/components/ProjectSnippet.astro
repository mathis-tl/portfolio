---
import type { PixelIconName } from "../lib/pixel-icons";
import Anchor from "./common/Anchor.astro";
import PixelIcon from "./PixelIcon.astro";

export type Props = {
	title: string;
	description: string;
	url: string;
	githubUrl?: string;
	liveUrl?: string;
	tags: string[];
	icon?: PixelIconName;
};

const { title, description, url, githubUrl, liveUrl, tags, icon } =
	Astro.props;
---

<div class="px-sparkle relative flex flex-col gap-3 mb-8 hover-zag-dotted-grid">
  <span class="px-stars" aria-hidden="true" />
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
    <div class="flex items-center gap-3">
      {icon && <PixelIcon name={icon} scale={2} class="shrink-0" />}
      <Anchor url={url} class="text-xl">
        {title}
      </Anchor>
    </div>
    <div class="flex gap-2">
      {
        githubUrl ? (
          <Anchor url={githubUrl} class="text-base" external>
            GitHub
          </Anchor>
        ) : null
      }
      {
        liveUrl ? (
          <Anchor url={liveUrl} class="text-base" external>
            En ligne
          </Anchor>
        ) : null
      }
    </div>
  </div>
  <p class="zag-text zag-transition">
    {description}
  </p>
  <div class="flex flex-row flex-wrap gap-2">
    {
      tags.map((tag) => (
        <span class="-zag-text -zag-bg zag-transition px-2 py-1 text-sm font-semibold">
          {tag}
        </span>
      ))
    }
  </div>
</div>
